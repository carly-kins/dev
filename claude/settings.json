{
  "permissions": {
    "ask": [
      "Bash(npm *)",
      "Bash(nvm *)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "autoUpdatesChannel": "stable",
  "tui": "default",
  "theme": "dark-ansi",
  "autoContinueAtUsageLimit": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/commit-guard.sh" }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/notes-guard.sh" }
        ]
      }
    ]
  }
}
